{
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "build:core": "pnpm --filter somenflow build",
    "build": "pnpm build:core",
    "dev": "pnpm --dir examples/astro-demo dev",
    "test": "pnpm build:core && vp test",
    "test:browser": "pnpm build:core && playwright test",
    "code:check": "vp check vite.config.ts playwright.config.ts packages/core/src packages/core/cli packages/core/test",
    "code:format": "vp fmt vite.config.ts playwright.config.ts packages/core/src packages/core/cli packages/core/test",
    "unused:check": "fallow dead-code --no-cache",
    "docs:check": "markdownlint-cli2 \"**/*.md\" && node scripts/check-doc-links.mjs",
    "prepare": "lefthook install",
    "somen": "node packages/core/cli/index.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "fallow": "3.31.0",
    "lefthook": "2.1.16",
    "markdownlint-cli2": "0.23.3",
    "typescript": "7.0.2",
    "vite-plus": "1.0.0"
  }
}

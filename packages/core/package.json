{
  "name": "somen",
  "version": "0.1.0-alpha.1",
  "description": "Small, framework-independent animated diagrams built with HTML and native SVG motion.",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "cli",
    "studio",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "import": "./dist/register.js"
    }
  },
  "bin": {
    "somen": "./cli/index.mjs"
  },
  "sideEffects": [
    "./dist/register.js"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "tsc -p tsconfig.json"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite-plus": "1.0.0-rc.1"
  }
}
